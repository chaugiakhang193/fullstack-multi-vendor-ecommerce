# search-service — bien moi truong (local dev). KHONG commit .env that.

# Cong HTTP cho health + (sau nay) /search. Chon 8090 de khong dung
# backend(8080) / notification(3001).
# LUU Y: tren Render/Cloud Run, bien PORT do nen tang tiem vao se DUOC UU TIEN
# hon bien nay — khong can (va khong nen) dat SEARCH_HTTP_PORT tren dashboard.
SEARCH_HTTP_PORT=8090

# RabbitMQ dung CHUNG voi monolith + notification-service.
# Local docker-compose: amqp://guest:guest@localhost:5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Ten queue consumer khai bao + tieu thu. Mac dinh search_index.v2.q (ban chay tren
# Render dung ten nay). Hau to .v2 co tu 13/08/2026 khi them TTL + DLX: doi args cua
# queue dang ton tai bi RabbitMQ tu choi bang 406 PRECONDITION_FAILED, nen bat buoc
# dung ten moi.
#
# Khi chay local ma broker tro toi CloudAMQP prod, PHAI doi sang ten khac — chung ten
# thi RabbitMQ chia round-robin, may local va Render moi ben chi an mot nua event.
# Khac ten = moi queue nhan mot ban sao day du.
SEARCH_QUEUE_NAME=search_index.v2.local.q

# Neon DB#3 (search-service). BAT BUOC sslmode=require (Neon chi nhan SSL).
# KHONG commit .env that; dan connection string that o terminal khi chay.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# debug | info | warn | error
LOG_LEVEL=info
