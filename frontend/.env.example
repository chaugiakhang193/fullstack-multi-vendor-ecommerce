NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile sitekey (public). Bỏ trống = widget không render (BE cũng fail-open).
# Dev có thể dùng test key luôn-pass của Cloudflare:
NEXT_PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA

# chat-service (chatbot Gemini). Trình duyệt gọi THẲNG service này, không proxy qua Next:
# proxy làm mọi khách vãng lai mang chung IP của serverless function, phá quota guest_daily.
# KHÔNG có dấu "/" ở cuối — chat-service so khớp Origin nguyên văn với FRONTEND_URL.
NEXT_PUBLIC_CHAT_SERVICE_URL=http://localhost:8091
