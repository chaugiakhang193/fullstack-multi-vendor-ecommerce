# Biến cho docker-compose (repo root). Copy sang `.env` nếu muốn đổi mặc định:
#   cp .env.docker.example .env
# Các biến này chỉ chi phối service Postgres + phần override DB của service backend
# trong docker-compose.yml. Nếu bỏ trống, compose dùng default ghi trong file.
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce

# Lưu ý: secret của app (JWT / Cloudinary / Mail / Google OAuth / Geocoding) KHÔNG
# nằm ở đây — chúng được nạp từ `backend/.env` qua `env_file` trong compose.
# => Trước khi `docker compose up`, đảm bảo `backend/.env` tồn tại
#    (copy từ backend/.env.example và điền secret).
