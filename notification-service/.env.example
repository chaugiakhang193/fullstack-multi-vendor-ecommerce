# Application Environment (development, production)
NODE_ENV=development

# Port (Render web service — free tier chỉ có web, NS phải tự listen PORT)
PORT=3001

# Message broker (RabbitMQ) — cùng CloudAMQP instance với backend
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis — dùng cho Phase 5 (redis-emitter), chưa dùng ở Phase 4
REDIS_URL=redis://localhost:6379

# Database — DB#2 OWN của Notification Service (database-per-service, Phase 6).
# Schema (notification, processed_events, notification_outbox) do migration NS
# tự dựng (migration:run:prod trong Dockerfile). synchronize:false.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Mail configuration (Gmail App Password hoặc SMTP) — dùng cho
# payout.status_changed (move từ backend, Phase 4 P4-6)
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_smtp_app_password

# part_02b: deep-link email take-down sản phẩm -> ${FRONTEND_URL}/seller/products/:id
FRONTEND_URL=http://localhost:3000

# Observability (chỉ bật ở local khi cần đo — xem week1_task_0727_0802_observability.md)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=notification-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
