# Application Environment (development, production)
NODE_ENV=development

# Port (Render web service — free tier chỉ có web, NS phải tự listen PORT)
PORT=3001

# Message broker (RabbitMQ) — cùng CloudAMQP instance với backend
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis — dùng cho Phase 5 (redis-emitter), chưa dùng ở Phase 4
REDIS_URL=redis://localhost:6379

# Database — SHARED Supabase (CÙNG DB backend, Phase 4 P4-3). Schema
# (notification, processed_events) do backend migration dựng — NS không có
# migration runner, synchronize:false.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Notification mode — 'inprocess' (default, NS chỉ log-only) | 'distributed'
# (NS consumer tạo notif). Phải khớp với backend, nếu không sẽ double-notify
# hoặc mất notif. Prod GIỮ inprocess.
NOTIFICATION_MODE=inprocess

# Mail configuration (Gmail App Password hoặc SMTP) — dùng cho
# payout.status_changed (move từ backend, Phase 4 P4-6)
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_smtp_app_password

# part_02b: deep-link email take-down sản phẩm -> ${FRONTEND_URL}/seller/products/:id
FRONTEND_URL=http://localhost:3000
