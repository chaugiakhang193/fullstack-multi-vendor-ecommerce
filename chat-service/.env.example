# chat-service — bien moi truong (local dev). KHONG commit .env that.

# Cong HTTP cho health, metrics, /chat va /ws. Chon 8091 de khong dung
# backend(8080) / notification(3001) / search(8090).
#
# LUU Y: config doc PORT TRUOC CHAT_HTTP_PORT, va Render tiem PORT vao. Chay bang
# docker-compose thi khoi environment phai de PORT tuong minh, vi env_file keo ca
# PORT=8080 cua backend sang - dat CHAT_HTTP_PORT thoi la khong du.
CHAT_HTTP_PORT=8091

# Neon DB#4 (chat-service). BAT BUOC sslmode=require voi Neon.
# Local docker-compose: postgres://postgres:postgres@localhost:5435/ecommerce?sslmode=disable
# KHONG commit .env that; dan connection string that o terminal khi chay.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# debug | info | warn | error
LOG_LEVEL=info

# Secret HS256 DUNG CHUNG voi monolith de verify access token. BAT BUOC, service chet
# luc khoi dong neu thieu.
#
# Lech mot ky tu voi monolith thi moi token deu bi tu choi trong khi token hoan toan
# dung: WebSocket dong ngay bang ma 4401, va nguoi dang nhap am tham bi coi la khach
# vang lai (tut tu 30 luot xuong 5 luot/ngay theo IP).
JWT_ACCESS_SECRET=<giong het backend/.env>

# Goc URL storefront. Dung o HAI cho: allowlist CORS cua cac route /chat, va link san
# pham gui kem cau tra loi cua bot.
#
# Dat lech domain that thi FE an 403 CORS o moi request, va bat tay WebSocket bi tu
# choi ngay cho nang cap - OriginPatterns doc chinh bien nay.
FRONTEND_URL=http://localhost:3000

# Goc URL search-service, de bot chay tool search_products.
# De rong = bot van tra loi duoc cau chao hoi va huong dan, chi khong tra cuu san pham.
SEARCH_SERVICE_URL=http://localhost:8090

# Goc URL monolith NestJS, de hoi "seller nay so huu shop nao" khi doc inbox 1-1.
# De rong = phan inbox cua seller tat, phan buyer van chay binh thuong.
MONOLITH_URL=http://localhost:8080

# Khoa goi Gemini. De rong duoc: service van chay, chi tat nhanh bot.
GEMINI_API_KEY=

# Ten model. De o env de doi model khong can deploy lai. Dong 2.5 da khoa voi key tao
# moi (goi that tra 404), nen phai o dong 3.
GEMINI_MODEL=gemini-3.5-flash-lite

# Kill switch cua nhanh chatbot. 'true' = bat; moi gia tri khac = tat.
# Tat chi chan duong TIEU TIEN (goi Gemini). Duong doc lich su van tra 200, va chat 1-1
# khong lien quan gi den co nay.
CHAT_BOT_ENABLED=true

# Han muc hoi dap. Dat sai dinh dang (chu, so am) thi service chet luc khoi dong chu
# khong am tham lay default.
#
# Khach vang lai dem theo IP that, nen mot van phong chung mot IP se chia nhau 5 luot.
BOT_GUEST_DAILY_LIMIT=5
BOT_USER_DAILY_LIMIT=30

# Tran theo gio cua mot tai khoan. Tran ngay mot minh khong chan duoc nguoi dot sach 30
# luot trong 2 phut roi bo di.
BOT_USER_HOURLY_LIMIT=10

# Tran cua CA service moi ngay - day moi la con so cuu quota Gemini, vi 100 IP x 5 tin
# da vuot free tier. LUU Y ten bien: DAILY_GLOBAL, khong phai GLOBAL_DAILY.
BOT_DAILY_GLOBAL_LIMIT=300

# Tran theo TOC DO, giu trong RAM va dat truoc ca cache: request bi no chan khong cham
# mot lenh DB nao.
BOT_BURST_CAPACITY=10
BOT_BURST_REFILL_SECONDS=6

# OpenTelemetry tracing. 'true' = bat; moi gia tri khac/de trong = tat.
# Local muon xem trace thi chay stack o docker-compose.observability.yml truoc.
OTEL_ENABLED=false

# Ten service hien tren he thong tracing.
OTEL_SERVICE_NAME=chat-service

# Endpoint nhan OTLP HTTP traces. Chi dung khi OTEL_ENABLED=true.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
